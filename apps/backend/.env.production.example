# AnimeClub backend production environment example.
# Keep real values in server/provider secrets, never in this file.

SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1

DB_URL=jdbc:postgresql://<host>:5432/animeclub?sslmode=require
DB_USERNAME=animeclub_app
DB_PASSWORD=
JPA_DDL_AUTO=validate
SQL_INIT_MODE=never

APP_FRONTEND_URL=https://animeclub.example
CORS_ALLOWED_ORIGINS=https://animeclub.example
CORS_ALLOWED_ORIGIN_PATTERNS=
MAIL_BRAND_IMAGE_URL=https://animeclub.example/assets/mail/confirmation-hero.jpg
MAIL_PASSWORD_RESET_IMAGE_URL=https://animeclub.example/assets/mail/password-reset-hero.jpg

EMAIL_CONFIRMATION_EXPOSE_LINK=false
ADMIN_IMPORT_TOKEN=
ADMIN_REQUIRE_TOKEN_ON_STARTUP=true
SECURITY_HSTS_ENABLED=true
ORIGIN_CHECK_ENABLED=true
SESSION_COOKIE_NAME=__Host-animeclub_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Lax

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_MAX_REQUESTS=120
RATE_LIMIT_SENSITIVE_MAX_REQUESTS=20

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@animeclub.example
SMTP_AUTH=true
SMTP_STARTTLS=true

MANAGEMENT_ENDPOINTS=health
MANAGEMENT_HEALTH_SHOW_DETAILS=never
MAIL_HEALTH_ENABLED=false
